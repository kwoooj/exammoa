# Cloudflare Pages 캐시 규칙.
#
# 해시가 붙은 자산은 영원히 캐시하고, HTML 과 데이터는 캐시하지 않는다.
# 일정 데이터는 하루 1회 바뀌는데 그것이 캐시에 갇히면 화면이 어제 일정을
# "최종 확인 오늘" 이라고 말한다 — 낡음을 숨기지 않는다는 규칙과 정면으로 어긋난다.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

n = noEvent;\r\n//우측 클릭 방지\r\n//const status2=\"Right click is not available.\";\r\nconst status2=\"오른쪽버튼을 이용할 수 없습니다.\";\r\nfunction disableclick(event){\r\n\tif ( event.button == 2 ){\r\n\t\t//alert(status2);\r\n\t\treturn false;\r\n\t}\r\n}\r\n//document.onmousedown = disableclick;\r\n//우클릭 방지\r\ndocument.oncontextmenu = function(e){\r\n//\talert(\"오른쪽버튼을 이용할 수 없습니다...\");\r\n\treturn false;\r\n}\r\n//드래그 방지\r\ndocument.ondragstart = new Function('return false');\r\n//선택 방지\r\ndocument.onselectstart = new Function('return false');\r\n</script>\r\n</head>\r\n\r\n<body>\r\n<div class=\"skipNav\">\r\n\t<a href=\"#header_btn\" id=\"header_btn\">상단메뉴 바로가기 </a>\r\n\t<a href=\"#container_btn\" id=\"container_btn\">본문 내용 바로가기 </a>\r\n\t<a href=\"#footer_btn\" id=\"footer_btn\">하단 주소 바로가기 </a>\r\n</div>\r\n<div id=\"header\">\r\n\r\n\r\n<script type=\"text/javascript\">\r\nvar mobileKeyWords = new Array('iPhone', 'iPod', 'BlackBerry', 'Android', 'Windows CE', 'LG', 'MOT', 'SAMSUNG', 'SonyEricsson');\r\nfor (var word in mobileKeyWords){\r\n\tif ( navigator.userAgent.match(mobileKeyWords[word]) != null ){\r\n\t\t\r\n\t\tlocation.href = \"http://m.historyexam.go.kr\";\r\n\t\tbreak;\r\n\t}\r\n}\r\n</script>\r\n<script type=\"text/javascript\">\r\n$(document).ready(function(){\r\n\t$('#searchKeyword2').focus();\r\n\t$('#searchKeyword2').bind('keydown', function(e){\r\n\t\tif ( e.keyCode == 13 ){// enter key\r\n\t\t\tfn_goSearch2();\r\n\t\t\treturn false;\r\n\t\t}\r\n\t});\r\n});\r\nfunction fn_goSearch2(){\r\n\tif ( $('#searchKeyword2').val() === \"\" ){\r\n\t\talert(\"검색어를 입력하세요.\");\r\n\t\t$('#searchKeyword2').focus();\r\n\t\treturn;\r\n\t}\r\n\t//NetFunnel Action\r\n\tNetFunnel_Action({action_id:'etcService'}, function(ev,ret){\r\n\t\t$('#searchFrm').attr('action', '/pst/searchList.do?netfunnel_key=' + ret.data.key);// 암호화된 넷퍼넬 키\r\n\t\t$('#searchFrm').submit();\r\n\t});\r\n}\r\n\r\nfunction gnbShow(){\r\n\t$('#gnb .close').show();\r\n\t$('.depth02').slideDown();\t\r\n}\r\n
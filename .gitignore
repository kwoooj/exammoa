node_modules/
dist/
*.log
.DS_Store

# tsc -b 의 증분 캐시. noEmit: true 여도 빌드 모드는 이걸 남긴다
# (npm run typecheck 는 tsc --noEmit 이라 안 남긴다 — 그래서 여태 안 걸렸다).
# 산출물을 의도적으로 추적하는 저장소라 git status 가 깨끗한지가 실제 신호다.
*.tsbuildinfo

# 비밀값. QNET_KEY 가 들어있다. 절대 커밋하지 않는다.
.env
.env.local

# 진단·스크래치 전용. 여기 있는 것은 잃어도 재생성된다.
#   probe-crawl.mjs → build/crawl-report.json, build/crawl/*.html
build/

# vite 가 서빙하는 사본. data/published/ 에서 복사되므로 원본이 아니다.
public/data/

# ⚠ data/published/ 와 data/archive/ 는 의도적으로 git 에 추적한다. ignore 하지 말 것.
#   CI 는 매번 깨끗한 체크아웃에서 돌기 때문에, 산출물이 저장소에 없으면
#   readPrevious() 가 항상 null 이고 '실패한 소스는 이전 결과 유지'(FR-DAT-07)가
#   코드와 무관하게 무동작이 된다. 근거는 docs/데이터-수집-활용.md §2.

# IDE. .iml 파일명에 폴더명이 박혀 사람마다 달라진다.
.idea/
.vscode/

# Claude Code — 공유 설정은 커밋하고 개인 설정만 제외한다
.claude/settings.local.json

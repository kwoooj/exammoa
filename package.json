{
  "name": "exam-timeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/publish.mjs",
    "dev": "vite",
    "prebuild": "node scripts/publish.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "probe": "node --env-file-if-exists=.env scripts/collect.mjs --probe",
    "probe:crawl": "node scripts/probe-crawl.mjs",
    "collect": "node --env-file-if-exists=.env scripts/collect.mjs",
    "publish:data": "node scripts/publish.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && node scripts/ci-gate.mjs --pr",
    "test": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
